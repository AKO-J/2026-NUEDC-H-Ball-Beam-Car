<?xml version="1.0" encoding="UTF-8"?>
<projectSpec>
    <applicability>
        <when>
            <context deviceFamily="ARM" deviceId="MSPM0G3507"/>
        </when>
    </applicability>
    <project
        title="lf04_ir_read_test"
        name="lf04_ir_read_test_LP_MSPM0G3507_nortos_ticlang"
        configurations="Debug"
        toolChain="TICLANG"
        connection="TIXDS110_Connection.xml"
        device="MSPM0G3507"
        ignoreDefaultDeviceSettings="false"
        ignoreDefaultCCSSettings="true"
        products="MSPM0-SDK"
        compilerBuildOptions="
            -I${PROJECT_ROOT}
            -D__MSPM0G3507__
            -O2
            -I${COM_TI_MSPM0_SDK_INSTALL_DIR}/source/third_party/CMSIS/Core/Include
            -I${COM_TI_MSPM0_SDK_INSTALL_DIR}/source
            -mcpu=cortex-m0plus
            -march=thumbv6m
            -mfloat-abi=soft
            -mthumb
            -Wall
        "
        linkerBuildOptions="
            -l${COM_TI_MSPM0_SDK_INSTALL_DIR}/source/ti/driverlib/lib/ticlang/m0p/mspm0g1x0x_g3x0x/driverlib.a
            -L${COM_TI_MSPM0_SDK_INSTALL_DIR}/source
            -L${PROJECT_ROOT}
            -Wl,--rom_model
            -Wl,--warn_sections
            -L${CG_TOOL_ROOT}/lib
            -llibc.a
        "
        sourceLookupPath="${COM_TI_MSPM0_SDK_INSTALL_DIR}/source/ti/driverlib"
        description="Safe LF04 four-channel and OLED readout; no motor output">
        <property name="buildProfile" value="release"/>
        <property name="isHybrid" value="true"/>
        <file path="../tests/bringup/ir_line_sensor_read_test.c" openOnCreation="true" excludeFromBuild="false" action="copy"/>
        <file path="../ir_line_sensor.c" openOnCreation="true" excludeFromBuild="false" action="copy"/>
        <file path="../ir_line_sensor.h" openOnCreation="false" excludeFromBuild="false" action="copy"/>
        <file path="../ssd1306_oled.c" openOnCreation="true" excludeFromBuild="false" action="copy"/>
        <file path="../ssd1306_oled.h" openOnCreation="false" excludeFromBuild="false" action="copy"/>
        <file path="../LF04_四路红外接线与首测.md" openOnCreation="true" excludeFromBuild="false" action="copy"/>
    </project>
</projectSpec>
